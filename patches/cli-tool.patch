diff --git a/crates/common/src/blockchain/cosmos/acp.rs b/crates/common/src/blockchain/cosmos/acp.rs
index d6024156..8345c6ea 100644
--- a/crates/common/src/blockchain/cosmos/acp.rs
+++ b/crates/common/src/blockchain/cosmos/acp.rs
@@ -258,6 +258,48 @@ impl VeraGoClient {
         .await
     }
 
+    /// Grant `relation` on an object to each DID in one transaction, registering
+    /// the object first when `register` is set. One block instead of one per
+    /// message, and it rolls back as a whole.
+    pub async fn acp_grant_batch(
+        &self,
+        policy_id: &str,
+        object: Object,
+        relation: &str,
+        dids: &[String],
+        register: bool,
+    ) -> Result<BroadcastResult> {
+        let signer = self.require_signer()?;
+        let cmd = |kind| cosmrs::Any {
+            type_url: MsgDirectPolicyCmd::TYPE_URL.to_string(),
+            value: MsgDirectPolicyCmd {
+                creator: signer.address(),
+                policy_id: policy_id.to_string(),
+                cmd: Some(PolicyCmd { kind: Some(kind) }),
+            }
+            .encode_to_vec(),
+        };
+        let mut msgs = Vec::with_capacity(dids.len() + 1);
+        if register {
+            msgs.push(cmd(PolicyCmdKind::RegisterObjectCmd(RegisterObjectCmd {
+                object: Some(object.clone()),
+            })));
+        }
+        for did in dids {
+            msgs.push(cmd(PolicyCmdKind::SetRelationshipCmd(SetRelationshipCmd {
+                relationship: Some(Relationship {
+                    object: Some(object.clone()),
+                    relation: relation.to_string(),
+                    subject: Some(Subject {
+                        kind: Some(SubjectKind::Actor(Actor { id: did.clone() })),
+                    }),
+                }),
+            })));
+        }
+        self.broadcast_proto_msgs_with_gas(msgs, self.config().gas_multiplier)
+            .await
+    }
