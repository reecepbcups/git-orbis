+/// Grant `relation` to every DID in one transaction, optionally registering
+/// the object in the same transaction.
+#[allow(clippy::too_many_arguments)]
+pub async fn grant_batch(
+    policy_id: String,
+    object_id: String,
+    resource: String,
+    relation: String,
+    dids: Vec<String>,
+    register: bool,
+    config: ChainConfig,
+    signing_key_hex: &str,
+) -> Result<()> {
+    let client = signed_vera_client(config, signing_key_hex).await?;
+    let document = Object {
+        resource,
+        id: object_id,
+    };
+    let result = client
+        .acp_grant_batch(&policy_id, document, &relation, &dids, register)
+        .await
+        .map_err(|e| anyhow!("Failed to grant batch: {}", e))?;
+    println!(
+        "[ACP] grant_batch({} dids): code={} hash={} log={}",
+        dids.len(),
+        result.code,
+        result.tx_hash,
+        result.log
+    );
+    ensure_tx_success("Failed to grant batch", &result)?;
+    Ok(())
+}
